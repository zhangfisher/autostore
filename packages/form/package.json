{
    "name": "@autostorejs/form",
    "version": "4.3.2",
    "description": "form webcomponent for autostore",
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./core": "./dist/core.js",
        "./browser": "./dist/index.global.js",
        "./browser/core": "./dist/iife/core.global.js",
        "./browser/widgets/*": "./dist/iife/widgets/*.global.js",
        "./widgets/*": "./dist/widgets/*.js"
    },
    "publishConfig": {
        "access": "public",
        "main": "dist/index.js",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "./core": {
                "types": "./dist/core.d.ts",
                "import": "./dist/core.js"
            },
            "./browser": "./dist/index.global.js",
            "./browser/core": "./dist/iife/core.global.js",
            "./browser/widgets/*": "./dist/iife/widgets/*.global.js",
            "./widgets/*": {
                "types": "./dist/widgets/*.d.ts",
                "import": "./dist/widgets/*.js"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite",
        "dev:examples": "vite examples",
        "build": "tsup && bun scripts/build-widget-iife.ts",
        "build:vite": "tsc && vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@autostorejs/plugins": "workspace:*",
        "@iconify-json/lucide": "^1.2.86",
        "@lit/context": "^1.1.6",
        "@shoelace-style/shoelace": "^2.20.1",
        "flex-tools": "^1.6.4",
        "lit": "3.3.2"
    },
    "devDependencies": {
        "@autostorejs/syncer": "workspace:*",
        "autostore": "workspace:*",
        "esbuild": "0.27.2",
        "esbuild-copy-files-plugin": "^1.2.1",
        "tsup": "^8.5.1",
        "typescript": "^6.0.2",
        "vite": "^7.1.9",
        "vite-plugin-cp": "^6.0.3",
        "vite-plugin-mock-dev-server": "^2.0.1",
        "zlib": "^1.0.5"
    },
    "peerDependencies": {
        "autostore": "workspace:*"
    }
}